# Copia este archivo a .env y completa los valores reales. .env está ignorado por git.
# Todas estas variables son solo de servidor: nunca llevan prefijo NEXT_PUBLIC_.

# Conexión directa a PostgreSQL (Supabase → Project Settings → Database).
# Usa la conexión directa o el pooler en modo sesión: el modo transacción
# no es compatible con `select ... for update` dentro de una transacción.
DATABASE_URL=

# Proyecto de Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Orígenes del frontend Vue permitidos por CORS, separados por coma
ALLOWED_ORIGINS=http://localhost:5173
