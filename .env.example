# Frontend: licencia Community o Commercial de PrimeNG.
# Copiar a .env y completar; en CI se puede definir la variable de proceso.
# El navegador recibe esta clave, pero nunca debe versionarse en el repositorio.
PRIMENG_LICENSE_KEY=

# URL del backend (solo el origen, sin ruta). Local: http://localhost:3000.
# Fuera de localhost debe ser https://. Se genera en src/app/core/api-base-url.generated.ts.
API_BASE_URL=http://localhost:3000
